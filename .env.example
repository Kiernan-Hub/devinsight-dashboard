# Optional overrides for the local Docker stack. Copy to `.env` (gitignored) and edit.
# `docker compose up` works with no .env at all — every value below has a default.

# Require this token on POST /api/ingest, as production does. Blank disables the check.
INGEST_TOKEN=

# Port the gateway (dashboard + /api + /rest/v1) listens on, on 127.0.0.1 only.
GATEWAY_PORT=8080

# Only for running the ingest server outside Docker, against a real Supabase project:
#   node --env-file=.env server.mjs
# The service-role key can write anything to the database. Never commit it.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
